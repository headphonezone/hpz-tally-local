# HPZ Tally app — Material Out + Stock Journal.
# Copy to .env and fill in. .env is gitignored; this file is the template.

# Port for the app's own web UI (http://localhost:7654).
PORT=7654

# Who can reach the app. Default 127.0.0.1 = this PC only, and with no accounts there is no login.
# On the shared server PC set 0.0.0.0 so other PCs can open it; the app then REQUIRES a login and refuses to
# start until at least one account exists (node scripts/user.mjs add <name>). See DEPLOY.md.
# HPZ_HOST=0.0.0.0

# TallyPrime's gateway. The app runs on the Tally PC, so this is always localhost.
HPZ_TALLY_URL=http://localhost:9000

# --- Stock Journal -> RMS link ----------------------------------------------------------
# The RMS backend. Stock Journal references are looked up here, and after a verified posting
# the voucher number and godown are written back. Plain outbound HTTPS — no tunnel needed.
#   production:  https://rms-backend-kmxjv4kksq-el.a.run.app   (the old ...jxdd2xlhbq... address is gone: every call returns 404)
#   local test:  http://localhost:4000
RMS_API_URL=

# Must equal RMS's AGENT_SECRET (Secret Manager secret AGENT_SECRET — the one the NVR agent uses).
RMS_AGENT_SECRET=

# Voucher numbers (RMS-N) are not configured here: the app reads the highest RMS-N from the open
# Tally company's Stock Journals and uses the next one. Each company has its own series.

# --- Unicommerce -> Sales voucher import ------------------------------------------------
# Auth is GET (not POST) on this tenant's proxy; export/job/create needs the Facility header below
# or it is refused ("Illegal Access, facility is required"). See lib/uc.mjs for the verified shape.
UNICOMMERCE_BASE_URL=
UNICOMMERCE_TOKEN_URL=
UNICOMMERCE_ORDER_URL=
UNICOMMERCE_CLIENT_ID=my-trusted-client
UNICOMMERCE_USERNAME=
UNICOMMERCE_PASSWORD=
UNICOMMERCE_FACILITY=

# --- E-Way Bill / E-Invoice tabs ---------------------------------------------------------
# Supabase holds who closed a document and why, returned invoices, and the saved portal checks
# (the same tables the 9am reminder mail reads). The SERVICE key — it never reaches the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# TaxPro GSP, e-Way Bill API (read only). Used by "Check portal" only: one PAID call per day that
# has never been pulled. Same values as Production ENV/.env.production of the E-way bill project.
TAXPRO_ASPID=
TAXPRO_ASPPWD=
TAXPRO_GSTIN=
TAXPRO_USERNAME=
TAXPRO_EWB_PWD=

# BlueDart manifest in BigQuery (project bluedart-webhook): path to a service-account JSON key with
# BigQuery Data Viewer + Job User. Used by the scheduled BlueDart check only (not by Check portal).
BLUEDART_SA_KEY=
# Couriers whose manifest dispatch closes an e-Way Bill / e-Invoice automatically.
DISPATCH_COURIERS=BLUEDART,SELF
# The scheduled BlueDart check: how often (minutes, min 5) and how many days of invoices back it reads
# from Tally (~1.6 s of Tally per day). It skips a round while another job holds Tally.
# BLUEDART_AUTO_MINUTES=15
# BLUEDART_AUTO_DAYS=14

# e-Way Bill due above this invoice value (business rule; statutory thresholds vary by state).
# EWB_THRESHOLD=50000

# --- Purchase Import tab (BOE Costing Portal -> import Purchase voucher) --------------------------
# The BOE Costing Portal's own Supabase project ("BOE-Costing"), read only: boes, boe_items and the
# Tally item links (migration 015). Use its service_role / secret key (Project Settings -> API keys).
BOE_SUPABASE_URL=https://lqurlldfpesbjhrkkczv.supabase.co
BOE_SUPABASE_KEY=
# Posting is refused unless this is "on". Leave it off until a test voucher posted from the tab has
# been read back and compared with a hand-entered import purchase.
PURCHASE_POSTING=off
