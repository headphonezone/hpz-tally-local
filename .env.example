# HPZ Tally app — Material Out + Stock Journal.
# Copy to .env and fill in. .env is gitignored; this file is the template.

# Port for the app's own web UI (http://localhost:7654).
PORT=7654

# TallyPrime's gateway. The app runs on the Tally PC, so this is always localhost.
HPZ_TALLY_URL=http://localhost:9000

# --- Stock Journal -> RMS link ----------------------------------------------------------
# The RMS backend. Stock Journal references are looked up here, and after a verified posting
# the voucher number and godown are written back. Plain outbound HTTPS — no tunnel needed.
#   production:  https://rms-backend-jxdd2xlhbq-el.a.run.app
#   local test:  http://localhost:4000
RMS_API_URL=

# Must equal RMS's AGENT_SECRET (Secret Manager secret AGENT_SECRET — the one the NVR agent uses).
RMS_AGENT_SECRET=

# The Stock Journal voucher series starts here when the local store is empty. RMS-1 to RMS-6 were
# already posted to Tally before this app existed, so it resumes at 7. Never set this to a number
# already used in Tally.
SJ_SERIES_START=7
